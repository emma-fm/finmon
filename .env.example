# --- Enable Banking (free "restricted production" app linked to your own accounts) ---
EB_APP_ID=
EB_PRIVATE_KEY_PATH=~/.config/finmon/enablebanking.pem
# Must match a redirect URL registered in your Enable Banking app. It doesn't need to load.
EB_REDIRECT_URL=https://localhost/finmon-callback
# Your bank's exact name as listed by `python -m finmon banks --search <part of the name>`
EB_ASPSP_NAME=
EB_COUNTRY=ES
# How long the bank access lasts before you must re-link (capped below the bank's maximum)
EB_CONSENT_DAYS=179

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (pick one provider; switching needs no code changes) ---
# claude-code        Claude Code CLI headless, uses a Claude subscription (default)
# anthropic          Anthropic API, pay per use (pip install anthropic; ANTHROPIC_API_KEY or LLM_API_KEY)
# openai-compatible  OpenAI / Ollama (local) / Mistral / Groq / OpenRouter / Gemini... (LLM_BASE_URL + LLM_MODEL)
# command            any CLI reading the prompt on stdin (LLM_COMMAND)
LLM_PROVIDER=claude-code
# Empty = provider default (claude-code: opus, anthropic: claude-opus-5-5)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_COMMAND=
# anthropic only: low | medium | high
LLM_EFFORT=
LLM_TIMEOUT=300

# claude-code provider: install Claude Code on the server, run `claude setup-token`, paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_BIN=/path/to/claude

# Examples:
#   Local & free with Ollama:  LLM_PROVIDER=openai-compatible LLM_BASE_URL=http://localhost:11434/v1 LLM_MODEL=qwen3:14b
#   Anthropic API:             LLM_PROVIDER=anthropic LLM_MODEL=claude-sonnet-5-5

# --- Monitor tuning ---
# Language of every message you receive (the code itself stays in English)
FINMON_LANGUAGE=Spanish
FINMON_TIMEZONE=Europe/Madrid
# Optional. Without it, your average of the last 3 months is the reference.
MONTHLY_BUDGET=
LARGE_EXPENSE_EUR=100
DIGEST_HOUR=21
# Categories that are not spending (moving money to yourself)
EXCLUDED_CATEGORIES=internal_transfer,savings
FIXED_CATEGORIES=housing,utilities,subscriptions,insurance,loans
